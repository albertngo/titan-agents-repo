{
  "permissions": {
    "allow": [
      "mcp__Claude_Code_Remote__add_repo",
      "mcp__Claude_Code_Remote__register_repo_root",
      "Bash(git clone --depth 1 https://github.com/albertngo/titan-vault *)",
      "Bash(echo \"# titan-agents-repo\")",
      "Bash(git init *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch *)",
      "Bash(git config *)",
      "Bash(git remote *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(rm -rf *)"
    ]
  },
  "agentPushNotifEnabled": true,
  "cleanupPeriodDays": 365,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "git -C \"${CLAUDE_PROJECT_DIR:-.}\" pull --ff-only 2>&1 || echo 'git pull --ff-only failed (offline or diverged) — continuing with local state'",
            "timeout": 30,
            "statusMessage": "Pulling latest from GitHub…"
          }
        ]
      }
    ]
  }
}
