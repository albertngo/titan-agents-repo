    "version": 1,
    "parameters": {},
    "mapper": {
     "model": "claude-sonnet-4-5",
     "max_tokens": 600,
     "textPrompt": "You are writing the top of a call note for Titan Flooring, a flooring retailer and installer in the Greater Toronto Area. Below is a transcript of one phone call, split into speaker turns. Direction: {{4.direction}}. Titan staff member on the line: {{9.staff}}.\n\nWrite exactly this, as plain text, and nothing else:\n\nSummary\n<at most 3 sentences: who called, what they want, and what was agreed. Name products, rooms, square footage and prices if they were said.>\n\nNext steps\n- Us: <what Titan promised> — by <date, or 'no date given'>\n- Customer: <what the customer will do> — by <date, or 'no date given'>\n(one line per commitment; write '- none' if nobody committed to anything)\n\nRules: use only what was actually said; never invent dates, prices or names; if it is unclear who is speaking, say 'unclear'. No remarks about how the staff member handled the call. If the recording has no real conversation, write 'Summary' then 'No conversation recorded.' and 'Next steps' then '- none'.\n\nTranscript:\n{{9.transcript}}"
    },
    "filter": {
     "name": "Transcript is not empty",
     "conditions": [
      [
       {
        "a": "{{9.transcript}}",
        "o": "exist"
       }
      ]
     ]
    },
