.env
.DS_Store
__pycache__/
*.pyc
analysis/cache/
# analysis/cache/ghl-calls/ holds call recordings, transcripts and bake-off sheets
# from scripts/ghl_calls_pull.py: customer PII, regenerable from GHL, never committed
# (the repo is public). The rule above already covers it; this is the record.
.venv/

# Lightspeed product bodies: regenerable from the API, ~9-41 MB per run.
# The committed record of a pull is the -summary.json beside them.
ingest/*/lightspeed-products.json

# Full-catalogue Airtable read for the promo lane (~2 MB a day, regenerable).
# The committed record is plans/<date>/catalog-plan-promo-sweep.json.
ingest/*/airtable-promo-snapshot.json

# /style-tag image originals and read copies: Airtable's copy, regenerable, and
# product photos would bloat the repo. The manifest in style-candidates-*.json is
# the committed record of what was read.
ingest/*/style-images/

# /image-fill downloads of supplier-website product images: regenerable from the
# site, and photos would bloat the repo. supplier-pages-*.json is the committed record.
ingest/*/supplier-images/
