.env
.DS_Store
__pycache__/
*.pyc
analysis/cache/
.venv/

# Claude Code harness state for background-agent worktree isolation.
# Ephemeral tooling state, not repo content -- other agents' live checkouts
# live here while they run and get cleaned up after.
.claude/worktrees/

# Lightspeed product bodies: regenerable from the API, ~9-41 MB per run.
# The committed record of a pull is the -summary.json beside them.
ingest/*/lightspeed-products.json
