# Titan Agents — environment contract.
# Copy to .env and fill in. NEVER commit .env. Cloud env vars are not a secrets
# store — treat anything there as visible.
# Check this EVERY run, not just at setup: before using any credential below,
# confirm it's actually loaded from .env, not a same-named cloud/session env var —
# see CLAUDE.md's Secrets section. A working env var is not proof it's safe.

# --- GoHighLevel (ghl-ingest-agent, ghl-actions-agent) ---
GHL_PIT_TOKEN=
GHL_LOCATION_ID=

# --- Microsoft Graph (outlook-ingest-agent via scripts/outlook_pull.py) ---
# App-only (client credentials) registration in Microsoft Entra ID.
# Application permission Mail.Read + admin consent, then RESTRICTED to just the
# Titan mailboxes with an Application Access Policy — without that policy the
# app can read every mailbox in the tenant.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Optional override; defaults to platform-settings/outlook-ingest-sources.json
OUTLOOK_MAILBOXES=albert@titanfloors.ca,info@titanfloors.ca

# --- Meta Marketing API (meta-ads-ingest-agent via scripts/meta_ads_pull.py) ---
# System User token from Meta Business Settings, granted ONLY ads_read and
# ONLY asset access to the Titan ad account. Never a personal user token.
META_ACCESS_TOKEN=
# Numeric ad account id, with or without the act_ prefix
META_AD_ACCOUNT_ID=
# Optional; defaults to v23.0
META_API_VERSION=

# --- Lightspeed Retail X-Series (scripts/lightspeed_pull.py) ---
# Titan is on X-Series (formerly Vend), not R-Series.
# DOMAIN_PREFIX is the <prefix> in <prefix>.retail.lightspeed.app.
LIGHTSPEED_DOMAIN_PREFIX=
# Generate at: Lightspeed > Setup > Personal tokens > Generate personal token.
# ALWAYS set an expiry. A personal token is NOT scopable — it carries the same
# data access as an Admin user, so there is no read-only variant to fall back on.
# The read-only guarantee on the pull side is structural instead: neither
# scripts/lightspeed_client.py nor scripts/lightspeed_pull.py contains a write
# code path, and tests/test_lightspeed.py fails if one is ever added.
# Keep this in .env only. Cloud env vars are visible — see the header above.
LIGHTSPEED_PERSONAL_TOKEN=
# Optional; overrides api.api_version in platform-settings/lightspeed.json.
# 2.0 is deprecated in favour of date-based versioning (e.g. 2026-01).
LIGHTSPEED_API_VERSION=

# --- Vault (vault-writer-agent) ---
VAULT_PATH=~/Documents/claude/titan-vault
# true only where no Obsidian git plugin sweeps up commits (cloud/VM sessions)
VAULT_AUTOPUSH=false

TZ=America/Toronto
